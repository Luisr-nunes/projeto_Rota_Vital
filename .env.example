# Perfil de execução
SPRING_PROFILES_ACTIVE=prod

# Porta da aplicação
SERVER_PORT=8080

# Banco PostgreSQL
POSTGRES_DB=hemorede
POSTGRES_USER=hemorede
POSTGRES_PASSWORD=troque_esta_senha_local

# Conexão da aplicação ao PostgreSQL no Docker Compose
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/hemorede
SPRING_DATASOURCE_USERNAME=hemorede
SPRING_DATASOURCE_PASSWORD=troque_esta_senha_local
