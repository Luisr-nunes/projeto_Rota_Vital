# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env está no .gitignore — nunca commite senhas reais.

POSTGRES_DB=rotavital
POSTGRES_USER=rotavital
POSTGRES_PASSWORD=troque-esta-senha

# Porta da API no host (http://localhost:8080)
API_PORT=8080

# Carga de dados sintéticos na primeira subida (ignorada se o banco já tiver dados)
HEMOREDE_SEED_ENABLED=true
