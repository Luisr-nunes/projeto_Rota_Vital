# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env está no .gitignore — nunca commite senhas reais.

POSTGRES_DB=rotavital
POSTGRES_USER=rotavital
POSTGRES_PASSWORD=troque-esta-senha

# Porta da API no host (http://localhost:8080)
API_PORT=8080

# Carga de dados sintéticos na primeira subida (ignorada se o banco já tiver dados)
HEMOREDE_SEED_ENABLED=true

# Autenticação (obrigatória em produção). Gere com: openssl rand -base64 48
# Sem padrão: com o perfil prod a API não sobe sem JWT_SECRET (mínimo de 32 caracteres).
JWT_SECRET=

# Senha das 3 contas de demonstração (hemocentro@, hospital.norte@ e doador@rotavital.dev).
# Vazia em produção = nenhuma conta demo é criada. Vazia em dev = senha aleatória exibida no log.
DEMO_SENHA=
