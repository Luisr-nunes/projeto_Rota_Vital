# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env está no .gitignore (raiz do repo) — nunca commite senhas reais.

POSTGRES_DB=rotavital
POSTGRES_USER=rotavital
POSTGRES_PASSWORD=troque-esta-senha

# Autenticação da API (mínimo de 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Senha das contas de demonstração (hemocentro@, hospital.norte@ e doador@rotavital.dev).
DEMO_SENHA=troque-esta-senha

# Grafana — troque a senha padrão antes de liberar o acesso ao professor (R5 do enunciado).
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-esta-senha

# Porta do Grafana no host — a única liberada no firewall/security list da VM.
GRAFANA_PORT=3000
